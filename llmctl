ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]*$")
_VAR_RE = re.compile(r"\$\{(\w+)(?::-([^}]*))?\}|\$(\w+)")


def expand(s):
    """Expand ~, $VAR, ${VAR} and ${VAR:-default} (default may itself contain $VAR)."""
    if not s:
        return s

    def rep(m):
        name = m.group(1) or m.group(3)
        val = os.environ.get(name)
        if val:
            return val
        if m.group(2) is not None:
            return expand(m.group(2))
        return m.group(0)

    return os.path.expanduser(_VAR_RE.sub(rep, s))


def model_path(raw):
    """Expand a model path. If `X.gguf` doesn't exist but a split model does, use its first part:
    `X-00001-of-N.gguf` next to it, or inside a folder named `X`."""
    p = expand(raw or "")
    if not p or os.path.isfile(p) or not p.endswith(".gguf"):
        return p
    base = p[:-len(".gguf")]
    folder, stem = os.path.split(base)
    for d in (folder, base):
        hits = sorted(glob.glob(os.path.join(glob.escape(d), glob.escape(stem) + "-00001-of-*.gguf")))
        if hits:
            return hits[0]
    return p


# --------------------------------------------------------------------------- config

class UserError(Exception):
    pass


def coerce(field, v):
    """Turn a JSON or CLI string value into the field's type. Blank means unset (None)."""
    t, key = field["type"], field["key"]
    if isinstance(v, str):
        v = v.strip()
        if t != "bool" and v.lower() in ("", "null", "none", "default"):
            return None
    if v is None:
        return False if t == "bool" else None
    try:
        if t in ("str", "path"):
            return str(v)
        if t == "bool":
            if isinstance(v, bool):
                return v
            s = str(v).lower()
            if s in ("1", "true", "yes", "on", "y"):
                return True
            if s in ("0", "false", "no", "off", "n", ""):
                return False
            raise ValueError
        if t == "int":
            if isinstance(v, bool):
                raise ValueError
            return int(v)
        if t == "float":
            return float(v)
        if t == "threads":
            return "auto" if str(v).lower() == "auto" else int(v)
        if t == "choice":
            if v not in field["choices"]:
                raise ValueError
            return v
    except (TypeError, ValueError):
        pass
    hint = f" (one of: {', '.join(field['choices'])})" if field["choices"] else f" (expected {t})"
    raise UserError(f"invalid value for {key}: {v!r}{hint}")


def normalize_model(m):
    out = {}
    for f in FIELDS:
        out[f["key"]] = coerce(f, m.get(f["key"]))
    return out


def validate_model(mid, m):
    if not ID_RE.match(mid or ""):
        raise UserError(f"invalid model id {mid!r} (letters, digits, . _ -)")
    if not m.get("model"):
        raise UserError(f"{mid}: 'model' (path to .gguf) is required")
    if not m.get("port") or not 1 <= m["port"] <= 65535:
        raise UserError(f"{mid}: 'port' must be 1-65535")
    if not m.get("ctx_size") or m["ctx_size"] < 1:
        raise UserError(f"{mid}: 'ctx_size' must be a positive number")
    if not m.get("host"):
        m["host"] = "127.0.0.1"
    if not m.get("name"):
        m["name"] = mid
    if m.get("extra_args"):
        try:
            shlex.split(m["extra_args"])
        except ValueError as e:
            raise UserError(f"{mid}: extra_args: {e}")
    return m


def default_config():
    return {"global": dict(DEFAULT_GLOBAL), "models": copy.deepcopy(DEFAULT_MODELS)}


_config_lock = threading.Lock()


def load_config():
    if not CONFIG_PATH.exists():
        cfg = default_config()
        save_config(cfg)
        return cfg
    try:
        raw = json.loads(CONFIG_PATH.read_text())
    except json.JSONDecodeError as e:
        raise UserError(f"{CONFIG_PATH} is not valid JSON: {e}")
    g = dict(DEFAULT_GLOBAL)
    g.update(raw.get("global") or {})
    models = {mid: normalize_model(m) for mid, m in (raw.get("models") or {}).items()}
    return {"global": g, "models": models}


def save_config(cfg):
    HOME_DIR.mkdir(parents=True, exist_ok=True)
    tmp = CONFIG_PATH.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(cfg, indent=2) + "\n")
    tmp.replace(CONFIG_PATH)


def next_free_port(cfg):
    used = {m.get("port") for m in cfg["models"].values()}
    return next(p for p in range(8108, 9000) if p not in used)


def get_model(cfg, mid):
    if mid not in cfg["models"]:
        known = ", ".join(cfg["models"]) or "none"
        raise UserError(f"unknown model {mid!r} (known: {known})")
    return cfg["models"][mid]


def apply_settings(m, pairs):
    """pairs: iterable of (key, raw value)."""
    m = dict(m)
    for key, val in pairs:
        if key not in FIELD_BY_KEY:
            raise UserError(f"unknown setting {key!r}. Settings: {', '.join(FIELD_BY_KEY)}")
        m[key] = coerce(FIELD_BY_KEY[key], val)
    return m


def parse_pairs(items):
    pairs = []
    for it in items:
        if "=" not in it:
            raise UserError(f"expected key=value, got {it!r}")
        k, v = it.split("=", 1)
        pairs.append((k.strip().replace("-", "_"), v))
    return pairs


# --------------------------------------------------------------------------- command line building

def resolve_binary(g):
    b = expand(g.get("llama_server") or "llama-server")
    if "/" in b:
        if os.path.isfile(b) and os.access(b, os.X_OK):
            return b
        raise UserError(f"llama-server not found at {b}")
    found = shutil.which(b)
    if found:
        return found
    for d in ("/opt/homebrew/bin", "/usr/local/bin", os.path.expanduser("~/.local/bin")):
        p = os.path.join(d, b)
        if os.path.isfile(p) and os.access(p, os.X_OK):
            return p
    raise UserError(f"'{b}' not found on PATH; set the llama-server path with "
                    f"`llmctl global llama_server=/path/to/llama-server`")


def build_cmd(m, g, resolve=True):
    if resolve:
        binary = resolve_binary(g)
    else:
        try:
            binary = resolve_binary(g)
        except UserError:
            binary = expand(g.get("llama_server") or "llama-server")
    cmd = [binary]
    for f in FIELDS:
        flag, v = f["flag"], m.get(f["key"])
        if not flag or v is None or v is False:
            continue
        if f["key"] == "pooling" and not m.get("embedding"):
            continue
        if f["type"] == "bool":
            cmd.append(flag)
            continue
        if f["key"] == "model":
            v = model_path(v)
        elif f["key"] == "threads" and v == "auto":
            v = os.cpu_count() or 4
        cmd += [flag, str(v)]
    if m.get("thinking"):
        cmd += thinking_args(m["thinking"], binary)
    if m.get("extra_args"):
        cmd += shlex.split(m["extra_args"])
    return cmd


FLAGS_CACHE = HOME_DIR / "server-flags.json"


def server_flags(binary):
    """Flags the llama-server binary knows (from --help), cached per binary path + mtime."""
    try:
        key = f"{binary}:{os.stat(binary).st_mtime}"
    except OSError:
        return set()
    try:
        cache = json.loads(FLAGS_CACHE.read_text())
    except (OSError, json.JSONDecodeError):
        cache = {}
    if key not in cache:
        try:
            out = subprocess.run([binary, "--help"], capture_output=True, text=True, timeout=20)
            text = out.stdout + out.stderr
        except Exception:
            return set()
        cache = {key: sorted(set(re.findall(r"--[a-z0-9][a-z0-9-]*", text)))}
        try:
            HOME_DIR.mkdir(parents=True, exist_ok=True)
            FLAGS_CACHE.write_text(json.dumps(cache))
        except OSError:
            pass
    return set(cache[key])


def thinking_args(value, binary):
    """Server flags for thinking on/off, using whichever mechanism this llama-server build has."""
    flags = server_flags(binary)
    if "--reasoning-budget" in flags or not flags:
        return ["--reasoning-budget", "-1" if value == "on" else "0"]
    if "--reasoning" in flags:
        return ["--reasoning", value]
    return ["--chat-template-kwargs", json.dumps({"enable_thinking": value == "on"})]


def client_host(m):
    h = m.get("host") or "127.0.0.1"
    return "127.0.0.1" if h in ("0.0.0.0", "::", "") else h


# --------------------------------------------------------------------------- process management

def run_file(mid):
    return RUN_DIR / f"{mid}.json"


def log_file(mid):
    return LOG_DIR / f"{mid}.log"


def read_run(mid):
    p = run_file(mid)
    if not p.exists():
        return None
    try:
        return json.loads(p.read_text())
    except (OSError, json.JSONDecodeError):
        return None


def pid_alive(run):
    pid = run["pid"]
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        pass
    # Guard against pid reuse: the process must still look like our server.
    try:
        out = subprocess.run(["ps", "-o", "command=", "-p", str(pid)],
                             capture_output=True, text=True, timeout=2).stdout
    except Exception:
        return True
    # The gateway runs under Python, which macOS framework builds re-exec as ".../Python.app/.../Python",
    # so match its arguments instead of the interpreter name.
    needle = "gateway run" if run["cmd"][-2:] == ["gateway", "run"] else os.path.basename(run["cmd"][0])
    return needle in out and "<defunct>" not in out


def health(m, timeout=0.5):
    url = f"http://{client_host(m)}:{m['port']}/health"
    try:
        with urllib.request.urlopen(url, timeout=timeout) as r:
            return "ready" if r.status == 200 else "loading"
    except urllib.error.HTTPError as e:
        return "loading" if e.code == 503 else "error"
    except Exception:
        return None


def port_in_use(host, port):
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.settimeout(0.3)
        return s.connect_ex((host, port)) == 0


def model_status(mid, m, g):
    path = model_path(m.get("model"))
    st = {
        "state": "stopped",
        "model_path": path,
        "model_found": os.path.isfile(path),
        "url": f"http://{client_host(m)}:{m['port']}/v1",
    }
    run = read_run(mid)
    if not run:
        return st
    if not pid_alive(run):
        st.update(state="exited", started=run.get("started"))
        return st
    h = health(m)
    st.update(
        state=h if h in ("ready", "loading") else "starting",
        pid=run["pid"],
        started=run.get("started"),
        # Config saved after start (or one-off overrides) -> running server differs.
        stale=run.get("cmd", [])[1:] != build_cmd(m, g, resolve=False)[1:],
    )
    return st


def _rotate_log(path):
    try:
        if path.stat().st_size > LOG_ROTATE_BYTES:
            path.replace(path.with_suffix(".log.1"))
    except FileNotFoundError:
        pass


def start_model(cfg, mid, m=None):
    """Start a model detached. `m` may carry one-off overrides; defaults to saved config."""
    g = cfg["global"]
    m = validate_model(mid, dict(m or get_model(cfg, mid)))
    run = read_run(mid)
    if run and pid_alive(run):
        raise UserError(f"{mid} is already running (pid {run['pid']})")
    path = model_path(m["model"])
    if not os.path.isfile(path):
        raise UserError(f"{mid}: model file not found: {path}")
    for other_id, other in cfg["models"].items():
        if other_id != mid and other["port"] == m["port"]:
            orun = read_run(other_id)
            if orun and pid_alive(orun):
                raise UserError(f"{mid}: port {m['port']} is used by running model {other_id}")
    if port_in_use(client_host(m), m["port"]):
        raise UserError(f"{mid}: something is already listening on port {m['port']}")
    cmd = build_cmd(m, g)

    RUN_DIR.mkdir(parents=True, exist_ok=True)
    LOG_DIR.mkdir(parents=True, exist_ok=True)
    lp = log_file(mid)
    _rotate_log(lp)
    logf = open(lp, "ab")
    logf.write(f"\n===== llmctl start {time.strftime('%Y-%m-%d %H:%M:%S')} =====\n"
               f"$ {shlex.join(cmd)}\n".encode())
    logf.flush()
    proc = subprocess.Popen(cmd, stdout=logf, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
                            start_new_session=True, close_fds=True)
    logf.close()
    # Reap the child if this process lives on (the UI); harmless for the CLI.
    threading.Thread(target=proc.wait, daemon=True).start()
    run_file(mid).write_text(json.dumps({"pid": proc.pid, "cmd": cmd, "started": time.time()}))
    time.sleep(0.4)
    if proc.poll() is not None:
        run_file(mid).unlink(missing_ok=True)
        raise UserError(f"{mid}: llama-server exited immediately (code {proc.returncode}).\n"
                        f"{tail(lp, 15)}")
    if g.get("gateway_autostart") and gateway_status(cfg)["state"] != "running":
        try:
            gateway_start(cfg)
        except UserError as e:
            print(f"warning: gateway not started: {e}", file=sys.stderr)
    return proc.pid


def stop_model(mid, timeout=15):
    run = read_run(mid)
    if not run:
        return False
    was_alive = pid_alive(run)
    if was_alive:
        pid = run["pid"]
        for sig, wait in ((signal.SIGTERM, timeout), (signal.SIGKILL, 5)):
            try:
                os.killpg(pid, sig)
            except ProcessLookupError:
                break
            except PermissionError:
                os.kill(pid, sig)
            deadline = time.time() + wait
            while time.time() < deadline and pid_alive(run):
                time.sleep(0.2)
            if not pid_alive(run):
                break
    run_file(mid).unlink(missing_ok=True)
    return was_alive


def wait_ready(cfg, mid, timeout=600, quiet=False):
    m = get_model(cfg, mid)
    t0 = time.time()
    while time.time() - t0 < timeout:
        run = read_run(mid)
        if not run or not pid_alive(run):
            raise UserError(f"{mid} exited while loading. Last log lines:\n{tail(log_file(mid), 20)}")
        if health(m) == "ready":
            return True
        if not quiet:
            print(f"\r  {mid}: loading... {int(time.time() - t0)}s", end="", flush=True)
        time.sleep(1)
    raise UserError(f"{mid}: not ready after {timeout}s")


def tail(path, n=100):
    path = Path(path)
    if not path.exists():
        return ""
    with open(path, "rb") as f:
        f.seek(0, 2)
        size = f.tell()
        f.seek(max(0, size - max(8192, n * 400)))
        data = f.read().decode(errors="replace")
    return "\n".join(data.splitlines()[-n:])


# --------------------------------------------------------------------------- model specs (GGUF metadata)

GGUF_FTYPES = {
    0: "F32", 1: "F16", 2: "Q4_0", 3: "Q4_1", 7: "Q8_0", 8: "Q5_0", 9: "Q5_1", 10: "Q2_K", 11: "Q3_K_S",
    12: "Q3_K_M", 13: "Q3_K_L", 14: "Q4_K_S", 15: "Q4_K_M", 16: "Q5_K_S", 17: "Q5_K_M", 18: "Q6_K",
    19: "IQ2_XXS", 20: "IQ2_XS", 21: "Q2_K_S", 22: "IQ3_XS", 23: "IQ3_XXS", 24: "IQ1_S", 25: "IQ4_NL",
    26: "IQ3_S", 27: "IQ3_M", 28: "IQ2_S", 29: "IQ2_M", 30: "IQ4_XS", 31: "IQ1_M", 32: "BF16",
    36: "TQ1_0", 37: "TQ2_0", 38: "MXFP4_MOE",
}
_GGUF_SCALAR = {0: "<B", 1: "<b", 2: "<H", 3: "<h", 4: "<I", 5: "<i", 6: "<f", 7: "<?",
                10: "<Q", 11: "<q", 12: "<d"}
# Bytes per KV-cache element for each --cache-type.
KV_BYTES = {None: 2, "f16": 2, "bf16": 2, "q8_0": 34 / 32, "q5_1": 24 / 32, "q5_0": 22 / 32,
            "q4_1": 20 / 32, "q4_0": 18 / 32}
_SPLIT_RE = re.compile(r"-(\d{5})-of-(\d{5})\.gguf$")
_spec_cache = {}


def gguf_metadata(path):
    """Read the GGUF key/value header. Big arrays (tokenizer vocab) are skipped, not loaded."""
    import struct
    with open(path, "rb") as f:
        def rd(fmt):
            return struct.unpack(fmt, f.read(struct.calcsize(fmt)))[0]

        def rstr():
            return f.read(rd("<Q")).decode("utf-8", "replace")

        def rval(t):
            if t == 8:
                return rstr()
            if t == 9:
                et, n = rd("<I"), rd("<Q")
                if et in _GGUF_SCALAR and n <= 1024:  # small arrays, e.g. per-layer head counts
                    return [rval(et) for _ in range(n)]
                if et in _GGUF_SCALAR:
                    f.seek(n * struct.calcsize(_GGUF_SCALAR[et]), 1)
                elif et == 8:
                    for _ in range(n):
                        f.seek(rd("<Q"), 1)
                else:
                    for _ in range(n):
                        rval(et)
                return None
            return rd(_GGUF_SCALAR[t])

        if f.read(4) != b"GGUF":
            raise UserError("not a GGUF file")
        version = rd("<I")
        if version < 2:
            raise UserError(f"GGUF v{version} is not supported")
        n_tensors, n_kv = rd("<Q"), rd("<Q")
        meta = {}
        for _ in range(n_kv):
            key = rstr()
            meta[key] = rval(rd("<I"))
    return meta, n_tensors


def _read_specs(path):
    meta, n_tensors = gguf_metadata(path)
    arch = meta.get("general.architecture", "")
    a = lambda k: meta.get(f"{arch}.{k}")
    files = [path]
    sm = _SPLIT_RE.search(path)
    if sm:
        files = [_SPLIT_RE.sub(f"-{i:05d}-of-{sm.group(2)}.gguf", path) for i in range(1, int(sm.group(2)) + 1)]
    layers = a("block_count") or 0
    heads = a("attention.head_count")
    kv = a("attention.head_count_kv")
    attn_layers = layers
    if isinstance(kv, list):  # per-layer; 0 = no attention in that layer (hybrid models)
        attn_layers = sum(1 for x in kv if x) or layers
        kv = max(kv) if kv else None
    if isinstance(heads, list):
        heads = max(heads) if heads else None
    # Hybrid models: only every n-th layer has full attention (and a KV cache). qwen3next GGUFs
    # don't store the interval; llama.cpp hard-codes 4 for that architecture.
    interval = a("full_attention_interval") or (4 if arch == "qwen3next" else None)
    if interval:
        attn_layers = layers // interval
    embd = a("embedding_length")
    head_dim = (embd // heads) if embd and heads else None
    return {
        "name": meta.get("general.name"),
        "architecture": arch,
        "size_label": meta.get("general.size_label"),
        "quant": GGUF_FTYPES.get(meta.get("general.file_type"), meta.get("general.file_type")),
        "file_bytes": sum(os.path.getsize(p) for p in files if os.path.isfile(p)),
        "files": len(files),
        "files_missing": sum(1 for p in files if not os.path.isfile(p)),
        "tensors": n_tensors,
        "trained_ctx": a("context_length"),
        "layers": layers,
        "attention_layers": attn_layers,
        "embedding_length": embd,
        "heads": heads,
        "kv_heads": kv,
        "key_length": a("attention.key_length") or head_dim,
        "value_length": a("attention.value_length") or head_dim,
        "experts": a("expert_count"),
        "experts_used": a("expert_used_count"),
        "pooling_type": a("pooling_type"),
        "chat_template": bool(meta.get("tokenizer.chat_template")),
        # "toggle" = template has an enable_thinking switch, "always" = thinks but can't be switched off
        "thinking_support": ("toggle" if "enable_thinking" in (meta.get("tokenizer.chat_template") or "")
                             else "always" if "<think>" in (meta.get("tokenizer.chat_template") or "")
                             else "none"),
    }


def model_specs(m):
    path = model_path(m.get("model"))
    try:
        st = os.stat(path)
    except OSError:
        return {"error": f"model file not found: {path}"}
    key = (path, st.st_mtime, st.st_size)
    if key not in _spec_cache:
        try:
            _spec_cache[key] = _read_specs(path)
        except Exception as e:
            _spec_cache[key] = {"error": f"cannot read GGUF metadata: {e}"}
    s = dict(_spec_cache[key])
    if "error" in s:
        return s
    # Estimates for the configured context (unified KV cache: independent of --parallel).
    ctx = m.get("ctx_size") or 0
    per_token = kvb = None
    if s["kv_heads"] and s["key_length"]:
        per_token = (s["attention_layers"] * s["kv_heads"] *
                     (s["key_length"] * KV_BYTES.get(m.get("cache_type_k"), 2) +
                      s["value_length"] * KV_BYTES.get(m.get("cache_type_v"), 2)))
        kvb = int(per_token * ctx)
    s["kv_bytes_per_token"] = per_token
    s["kv_cache_bytes"] = kvb
    s["est_memory_bytes"] = s["file_bytes"] + (kvb or 0)
    warn = []
    if s["trained_ctx"] and ctx > s["trained_ctx"]:
        warn.append(f"ctx_size {ctx} exceeds the trained context {s['trained_ctx']}")
    if s["files_missing"]:
        warn.append(f"{s['files_missing']} of {s['files']} split files missing")
    if m.get("jinja") and not s["chat_template"]:
        warn.append("--jinja set but the GGUF has no chat template")
    if m.get("thinking") and s["thinking_support"] != "toggle":
        warn.append(f"thinking={m['thinking']} has no effect: " +
                    ("this model always thinks" if s["thinking_support"] == "always"
                     else "this model has no thinking mode"))
    if m.get("thinking") and not m.get("jinja"):
        warn.append("thinking needs jinja=true")
    s["warnings"] = warn
    return s


def fmt_bytes(n):
    return "?" if n is None else f"{n / 1e9:.1f} GB" if n >= 1e9 else f"{n / 1e6:.0f} MB"


def fmt_ctx(n):
    return "?" if not n else f"{n // 1024}k" if n % 1024 == 0 else str(n)


