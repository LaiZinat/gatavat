GATEWAY_ID = "_gateway"  # model ids can't start with "_", so no clash with run/log files


def gateway_url(g):
    h = g.get("gateway_host") or "127.0.0.1"
    return f"http://{'127.0.0.1' if h in ('0.0.0.0', '::') else h}:{g['gateway_port']}/v1"


def gateway_status(cfg):
    st = {"state": "stopped", "url": gateway_url(cfg["global"])}
    run = read_run(GATEWAY_ID)
    if run and pid_alive(run):
        st.update(state="running", pid=run["pid"], started=run.get("started"))
    return st


def gateway_start(cfg):
    g = cfg["global"]
    if gateway_status(cfg)["state"] == "running":
        return
    host = g.get("gateway_host") or "127.0.0.1"
    if port_in_use("127.0.0.1" if host in ("0.0.0.0", "::") else host, g["gateway_port"]):
        raise UserError(f"gateway: something is already listening on port {g['gateway_port']}")
    cmd = [sys.executable, str(Path(__file__).resolve()), "gateway", "run"]
    RUN_DIR.mkdir(parents=True, exist_ok=True)
    LOG_DIR.mkdir(parents=True, exist_ok=True)
    lp = log_file(GATEWAY_ID)
    _rotate_log(lp)
    with open(lp, "ab") as logf:
        proc = subprocess.Popen(cmd, stdout=logf, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
                                start_new_session=True, close_fds=True)
    threading.Thread(target=proc.wait, daemon=True).start()
    run_file(GATEWAY_ID).write_text(json.dumps({"pid": proc.pid, "cmd": cmd, "started": time.time()}))
    time.sleep(0.4)
    if proc.poll() is not None:
        run_file(GATEWAY_ID).unlink(missing_ok=True)
        raise UserError(f"gateway exited immediately:\n{tail(lp, 10)}")


def gateway_stop():
    return stop_model(GATEWAY_ID, timeout=5)


def find_model(cfg, name):
    """Match a request's model name against alias or id; tolerates a "provider/" prefix."""
    for mid, m in cfg["models"].items():
        if name in (mid, m.get("alias")):
            return mid, m
    if name and "/" in name:
        return find_model(cfg, name.split("/", 1)[1])
    return None, None


class GatewayHandler(BaseHTTPRequestHandler):
    server_version = "llmctl-gateway"

    def log_message(self, fmt, *args):
        sys.stdout.write(f"{time.strftime('%H:%M:%S')} {fmt % args}\n")
        sys.stdout.flush()

    def _error(self, code, msg):
        data = json.dumps({"error": {"message": msg, "type": "llmctl_gateway", "code": code}}).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def _json(self, obj):
        data = json.dumps(obj).encode()
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        path = urlparse(self.path).path.rstrip("/")
        cfg = load_config()
        if path in ("/health", "/v1/health"):
            return self._json({"status": "ok"})
        if path == "/v1/models":
            data = []
            for mid, m in cfg["models"].items():
                st = model_status(mid, m, cfg["global"])["state"]
                data.append({"id": m.get("alias") or mid, "object": "model", "owned_by": "llmctl",
                             "llmctl_id": mid, "state": st, "port": m["port"]})
            return self._json({"object": "list", "data": data})
        self._error(404, f"not found: {path}")

    def do_POST(self):
        path = urlparse(self.path).path
        if not path.startswith("/v1/"):
            return self._error(404, f"not found: {path}")
        raw = self.rfile.read(int(self.headers.get("Content-Length") or 0))
        try:
            name = json.loads(raw or b"{}").get("model")
        except (json.JSONDecodeError, AttributeError):
            return self._error(400, "request body must be JSON")
        cfg = load_config()
        mid, m = find_model(cfg, name)
        if not m:
            known = ", ".join(x.get("alias") or i for i, x in cfg["models"].items())
            return self._error(404, f"unknown model {name!r}; available: {known}")
        state = model_status(mid, m, cfg["global"])["state"]
        if state in ("stopped", "exited"):
            return self._error(503, f"model {mid} is not running. Start it with `llmctl start {mid}` or in the llmctl UI.")
        try:
            upstream = _post_json(m, path, raw)
        except UpstreamError as e:
            return self._error(e.code, f"{mid}: {e}")
        pipe_response(self, upstream)


def run_gateway(cfg):
    g = cfg["global"]
    host = g.get("gateway_host") or "127.0.0.1"
    try:
        srv = ThreadingHTTPServer((host, g["gateway_port"]), GatewayHandler)
    except OSError as e:
        raise UserError(f"gateway: cannot listen on {host}:{g['gateway_port']}: {e}")
    print(f"llmctl gateway on {gateway_url(g)}", flush=True)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        srv.server_close()


