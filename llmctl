            print(f"{mid}\n  {s['error']}\n")
            continue
        tags = ", ".join(x for x in (s["architecture"], s["size_label"], s["quant"]) if x)
        print(f"{mid}  {s['name'] or ''}  ({tags})")
        files = f" in {s['files']} files" if s["files"] > 1 else ""
        print(f"  file          {fmt_bytes(s['file_bytes'])}{files}, {s['tensors']} tensors")
        print(f"  context       trained {fmt_ctx(s['trained_ctx'])}, configured {fmt_ctx(m['ctx_size'])}")
        arch = f"  layers        {s['layers']}"
        if s["attention_layers"] != s["layers"]:
            arch += f" ({s['attention_layers']} attention)"
        arch += f", embd {s['embedding_length']}, heads {s['heads']} / {s['kv_heads']} kv"
        if s["experts"]:
            arch += f", experts {s['experts']} ({s['experts_used']} active)"
        print(arch)
        kv_type = m.get("cache_type_k") or "f16"
        print(f"  KV cache      ~{fmt_bytes(s['kv_cache_bytes'])} at ctx {fmt_ctx(m['ctx_size'])} ({kv_type})")
        print(f"  est. memory   ~{fmt_bytes(s['est_memory_bytes'])} + compute buffers")
        print(f"  chat template {'yes' if s['chat_template'] else 'no'}")
        think = {"toggle": f"switchable (setting: {m.get('thinking') or 'model default'})",
                 "always": "always on", "none": "no"}[s["thinking_support"]]
        print(f"  thinking      {think}")
        for w in s["warnings"]:
