def cmd_info(cfg, args):
    ids = args.ids or list(cfg["models"])
    specs = {mid: model_specs(get_model(cfg, mid)) for mid in ids}
    if args.json:
        print(json.dumps(specs, indent=2))
        return
    for mid in ids:
        m, s = cfg["models"][mid], specs[mid]
