def opencode_profiles(g):
    d = Path(expand(g.get("opencode_profiles_dir") or "~/.config/opencode/profiles"))
    return d, sorted(p.stem for p in d.glob("*.json")) if d.is_dir() else []


def cmd_oc(cfg, args):
    g = cfg["global"]
    pdir, names = opencode_profiles(g)
    if args.list:
        print(f"profiles in {pdir}:")
        for n in names:
            print(f"  {n}" + ("  (default)" if n == g.get("opencode_default_profile") else ""))
        if not names:
            print("  (none)")
        return
    profile = args.profile or g.get("opencode_default_profile") or None
    env = dict(os.environ)
    if profile and profile != "default":
        path = Path(expand(profile)) if ("/" in profile or profile.endswith(".json")) else pdir / f"{profile}.json"
        if not path.is_file():
            raise UserError(f"opencode profile not found: {path}" +
                            (f" (available: {', '.join(names)})" if names else ""))
        env["OPENCODE_CONFIG"] = str(path)
    for mid in args.start or []:
        m = get_model(cfg, mid)
        if model_status(mid, m, g)["state"] in ("stopped", "exited"):
            start_model(cfg, mid)
            print(f"started {mid}")
        wait_ready(cfg, mid)
        print(f"\r  {mid}: ready" + " " * 20)
    binary = shutil.which(expand(g.get("opencode_bin") or "opencode"))
    if not binary:
        raise UserError("opencode not found on PATH; set it with `llmctl global opencode_bin=/path/to/opencode`")
    extra = args.args
    if "OPENCODE_CONFIG" in env:
        print(f"OPENCODE_CONFIG={env['OPENCODE_CONFIG']}", flush=True)
    os.execvpe(binary, [binary] + extra, env)


