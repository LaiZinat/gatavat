def set_global(cfg, key, value):
    if key not in DEFAULT_GLOBAL:
        raise UserError(f"unknown global setting {key!r} ({', '.join(DEFAULT_GLOBAL)})")
    default = DEFAULT_GLOBAL[key]
    if isinstance(default, bool):
        value = coerce({"type": "bool", "key": key, "choices": None}, value)
    elif isinstance(default, int):
        value = coerce({"type": "int", "key": key, "choices": None}, value)
    else:
        value = str(value).strip()
    if key == "opencode_mode" and value not in ("gateway", "per-model"):
        raise UserError("opencode_mode must be 'gateway' or 'per-model'")
    cfg["global"][key] = value


