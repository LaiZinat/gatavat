STATE_LABEL = {"ready": "ready", "loading": "loading", "starting": "starting",
               "stopped": "stopped", "exited": "exited!"}


def fmt_age(ts):
    if not ts:
        return ""
    s = int(time.time() - ts)
    return f"{s // 3600}h{s % 3600 // 60:02d}m" if s >= 3600 else f"{s // 60}m{s % 60:02d}s"


def resolve_ids(cfg, ids, all_flag, default_autostart=False):
    if all_flag:
        return list(cfg["models"])
    if ids:
        for mid in ids:
            get_model(cfg, mid)
        return ids
    if default_autostart:
        auto = [mid for mid, m in cfg["models"].items() if m.get("autostart")]
        if not auto:
            raise UserError("no model ids given and no model has autostart=true")
        return auto
    raise UserError("give one or more model ids, or --all")


def cmd_status(cfg, args):
    rows = [("ID", "STATE", "PORT", "CTX", "PID", "UP", "ENDPOINT", "NOTES")]
    for mid, m in cfg["models"].items():
        st = model_status(mid, m, cfg["global"])
        notes = []
        if not st["model_found"]:
            notes.append("model file missing")
        if st.get("stale"):
            notes.append("config changed, restart to apply")
        if m.get("autostart"):
            notes.append("autostart")
        rows.append((mid, STATE_LABEL[st["state"]], str(m["port"]), str(m["ctx_size"]),
                     str(st.get("pid", "")), fmt_age(st.get("started")) if st.get("pid") else "",
                     st["url"], ", ".join(notes)))
    widths = [max(len(r[i]) for r in rows) for i in range(len(rows[0]))]
    for r in rows:
        print("  ".join(c.ljust(w) for c, w in zip(r, widths)).rstrip())
    gw = gateway_status(cfg)
    print(f"\ngateway {gw['state']}" + (f" (pid {gw['pid']})" if gw.get("pid") else "") +
          f" -> {gw['url']}  (one endpoint for all models, routed by model name)")
    if opencode_stale(cfg):
        print(f"\nnote: {OPENCODE_HINT}")


def cmd_start(cfg, args):
    ids = resolve_ids(cfg, args.ids, args.all, default_autostart=True)
    overrides = parse_pairs(args.set or [])
    if args.ctx:
        overrides.append(("ctx_size", args.ctx))
    if args.port:
        if len(ids) > 1:
            raise UserError("--port only makes sense with a single model")
        overrides.append(("port", args.port))
    if args.save and overrides:
        for mid in ids:
            cfg["models"][mid] = validate_model(mid, apply_settings(cfg["models"][mid], overrides))
        save_config(cfg)
    failed = False
    for mid in ids:
        m = apply_settings(cfg["models"][mid], overrides)
        try:
            pid = start_model(cfg, mid, m)
            print(f"started {mid} (pid {pid}) -> http://{client_host(m)}:{m['port']}/v1   ctx {m['ctx_size']}")
        except UserError as e:
            failed = True
            print(f"error: {e}", file=sys.stderr)
    if args.wait:
        for mid in ids:
            if read_run(mid):
                try:
                    wait_ready(cfg, mid)
                    print(f"\r  {mid}: ready" + " " * 20)
                except UserError as e:
                    failed = True
                    print(f"\nerror: {e}", file=sys.stderr)
    elif not failed:
        print("models load in the background; `llmctl status` or `llmctl logs <id> -f` to follow")
    return 1 if failed else 0


def cmd_stop(cfg, args):
    ids = resolve_ids(cfg, args.ids, args.all)
    for mid in ids:
        print(f"stopped {mid}" if stop_model(mid) else f"{mid} was not running")


def cmd_restart(cfg, args):
    for mid in resolve_ids(cfg, args.ids, args.all):
        stop_model(mid)
    args.set, args.ctx, args.port, args.save = None, None, None, False
    return cmd_start(cfg, args)


