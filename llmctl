        print()


def cmd_chat(cfg, args):
    mid = args.id
    m = get_model(cfg, mid)
    st = model_status(mid, m, cfg["global"])
    if st["state"] != "ready":
        raise UserError(f"{mid} is {st['state']}" + ("" if st["state"] == "loading" else f"; start it with `llmctl start {mid}`"))
    tty = sys.stdout.isatty()
    dim, bold, reset = ("\033[2m", "\033[1m", "\033[0m") if tty else ("", "", "")

    if m.get("embedding"):
        prev = None

        def run(text):
            nonlocal prev
            t0 = time.time()
            v = embed(m, text)
            norm = sum(x * x for x in v) ** 0.5
            head = ", ".join(f"{x:.4f}" for x in v[:6])
            print(f"dim {len(v)} · norm {norm:.4f} · [{head}, ...] · {time.time() - t0:.2f}s")
            if prev is not None:
                print(f"cosine similarity to previous input: {cosine(prev, v):.4f}")
            prev = v

        if args.prompt:
            run(" ".join(args.prompt))
            return
        print(f"{bold}{mid}{reset} embedding test: each line is embedded and compared to the previous one. Ctrl-D to quit.")
        while True:
            try:
                text = input("text> ").strip()
            except (EOFError, KeyboardInterrupt):
                print()
                return
            if text:
                run(text)

    params = {"max_tokens": args.max_tokens}
    think = args.think

    def set_think(v):
        nonlocal think
        think = v
        if v:
            params["chat_template_kwargs"] = {"enable_thinking": v == "on"}
        else:
            params.pop("chat_template_kwargs", None)

    set_think(think)
    if args.temp is not None:
        params["temperature"] = args.temp
    system = args.system
    history = []

    def ask(text):
        msgs = ([{"role": "system", "content": system}] if system else []) + history + [{"role": "user", "content": text}]
        state = {"thinking": False}

        def on_reasoning(s):
            if args.no_think:
                return
            if not state["thinking"]:
                sys.stdout.write(dim + "thinking: ")
                state["thinking"] = True
            sys.stdout.write(s)
            sys.stdout.flush()

        def on_content(s):
            if state["thinking"]:
                sys.stdout.write(reset + "\n\n")
                state["thinking"] = False
            sys.stdout.write(s)
            sys.stdout.flush()

        t0 = time.time()
        try:
            content, timings = stream_chat(m, msgs, params, on_content, on_reasoning)
        except KeyboardInterrupt:
            print(f"{reset}\n{dim}[stopped]{reset}")
            return
        print(f"{reset}\n{dim}{fmt_timings(timings, time.time() - t0)}{reset}")
        history.extend([{"role": "user", "content": text}, {"role": "assistant", "content": content}])

    if args.prompt:
        ask(" ".join(args.prompt))
        return
    print(f"{bold}{mid}{reset} chat ({st['url']}). Commands: /clear, /system <text>, /think on|off|default, /exit. Ctrl-C stops a reply.")
    while True:
        try:
            text = input(f"{bold}you>{reset} ").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            return
        if not text:
            continue
        if text in ("/exit", "/quit"):
            return
        if text == "/clear":
            history.clear()
            print("history cleared")
            continue
        if text.startswith("/think"):
            v = text[len("/think"):].strip()
            if v not in ("on", "off", "default"):
                print("usage: /think on|off|default")
                continue
            set_think(None if v == "default" else v)
            print(f"thinking: {v}")
            continue
        if text.startswith("/system"):
            system = text[len("/system"):].strip() or None
            print(f"system prompt: {system or '(none)'}")
            continue
        ask(text)


