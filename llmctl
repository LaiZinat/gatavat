def main(argv=None):
    settings_help = "settings: " + ", ".join(FIELD_BY_KEY)
    ap = argparse.ArgumentParser(
        prog="llmctl",
        description="Configure and run local llama-server models (CLI + web UI).",
        epilog=f"Config: {CONFIG_PATH}. Override location with LLMCTL_HOME.\n{settings_help}",
    )
    ap.add_argument("--version", action="version", version=f"llmctl {__version__}")
    sub = ap.add_subparsers(dest="command", metavar="<command>")

    def add(name, fn, help, aliases=()):
        p = sub.add_parser(name, help=help, aliases=list(aliases), description=help)
        p.set_defaults(fn=fn)
        return p

    add("status", cmd_status, "show all models and whether they are running", ["ls", "list", "ps"])

    p = add("start", cmd_start, "start models in the background (no ids = autostart models)", ["up"])
    p.add_argument("ids", nargs="*")
    p.add_argument("-a", "--all", action="store_true", help="start every configured model")
    p.add_argument("-c", "--ctx", type=int, help="context size for this start")
    p.add_argument("-p", "--port", type=int, help="port for this start")
    p.add_argument("-s", "--set", action="append", metavar="KEY=VALUE", help="one-off setting (repeatable)")
    p.add_argument("--save", action="store_true", help="also save --ctx/--port/--set to the config")
    p.add_argument("-w", "--wait", action="store_true", help="wait until the models are loaded")

    p = add("stop", cmd_stop, "stop models", ["down"])
    p.add_argument("ids", nargs="*")
    p.add_argument("-a", "--all", action="store_true")

    p = add("restart", cmd_restart, "restart models (applies saved config changes)")
    p.add_argument("ids", nargs="*")
    p.add_argument("-a", "--all", action="store_true")
    p.add_argument("-w", "--wait", action="store_true")

    p = add("show", cmd_show, "show a model's settings and command line")
    p.add_argument("id")
    p = add("info", cmd_info, "model specs from the GGUF file + memory estimate", ["specs"])
    p.add_argument("ids", nargs="*")
    p.add_argument("--json", action="store_true")
    p = add("chat", cmd_chat, "chat with a running model (embedding models: similarity test)")
    p.add_argument("id")
    p.add_argument("prompt", nargs="*", help="one-shot prompt; omit for an interactive chat")
    p.add_argument("--system", help="system prompt")
    p.add_argument("-t", "--temp", type=float, help="temperature (default: the server's)")
    p.add_argument("-m", "--max-tokens", type=int, default=2048)
    p.add_argument("--think", choices=["on", "off"], help="turn thinking on/off for these requests "
                   "(hybrid models only; default: the server's setting)")
    p.add_argument("--no-think", action="store_true", help="hide the model's reasoning output")
    p = add("cmd", cmd_cmd, "print the llama-server command for a model")
    p.add_argument("id")

    p = add("set", cmd_set, "change saved settings, e.g. `llmctl set qwen3-coder ctx_size=131072`")
    p.add_argument("id")
    p.add_argument("pairs", nargs="+", metavar="KEY=VALUE", help=settings_help + " (empty value = unset)")

    p = add("add", cmd_add, "add a model, e.g. `llmctl add mymodel model=~/m.gguf port=8106`")
    p.add_argument("id")
    p.add_argument("pairs", nargs="*", metavar="KEY=VALUE")
    p.add_argument("--from", dest="from_", metavar="ID", help="copy settings from an existing model")

    p = add("remove", cmd_remove, "remove a model from the config", ["rm"])
    p.add_argument("id")
    p = add("reset", cmd_reset, "restore built-in defaults (all built-in models if no ids)")
    p.add_argument("ids", nargs="*")

    p = add("logs", cmd_logs, "show a model's server log")
    p.add_argument("id")
    p.add_argument("-n", type=int, default=50, help="lines to show (default 50)")
    p.add_argument("-f", "--follow", action="store_true")

    p = add("run", cmd_run, "run a model in the foreground (Ctrl-C stops it)")
    p.add_argument("id")
    p.add_argument("-s", "--set", action="append", metavar="KEY=VALUE")

    p = add("global", cmd_global, "show or change global settings (llama_server, gateway_*, opencode_*, ui_*)")
    p.add_argument("pairs", nargs="*", metavar="KEY=VALUE")

    p = add("gateway", cmd_gateway, "one endpoint (port 8100) for all models, routed by model name")
    p.add_argument("action", nargs="?", default="status", choices=["status", "start", "stop", "restart", "run"])

    p = add("opencode", cmd_opencode, "preview or write opencode.json providers from this config")
    p.add_argument("--write", action="store_true", help="write it (existing file is backed up first)")

    p = add("oc", cmd_oc, "start opencode with a config profile, e.g. `llmctl oc laizinat`", ["code"])
    p.add_argument("profile", nargs="?", help="name in the profiles dir, a path to a .json, or 'default' "
                   "for opencode's normal config (default: opencode_default_profile)")
    p.add_argument("-s", "--start", action="append", metavar="ID", help="start this model first and wait "
                   "until it is ready (repeatable)")
    p.add_argument("-l", "--list", action="store_true", help="list available profiles")
    p.add_argument("args", nargs="*", help="after --: arguments passed to opencode")

    p = add("ui", cmd_ui, "open the web UI")
    p.add_argument("--host")
    p.add_argument("--port", type=int)
    p.add_argument("--no-open", action="store_true", help="don't open a browser")

    p = add("config", cmd_config, "print the config file path")
    p.add_argument("--edit", action="store_true", help="open it in $EDITOR")

    args = ap.parse_args(argv)
    if not getattr(args, "fn", None):
        args = ap.parse_args(["status"])
    try:
        cfg = load_config()
        return args.fn(cfg, args) or 0
    except UserError as e:
        print(f"error: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
