def _server_url(m, path):
    return f"http://{client_host(m)}:{m['port']}{path}"


class UpstreamError(UserError):
    def __init__(self, msg, code=502):
        super().__init__(msg)
        self.code = code


def _post_json(m, path, body, timeout=600):
    data = body if isinstance(body, bytes) else json.dumps(body).encode()
    req = urllib.request.Request(_server_url(m, path), data=data, headers={"Content-Type": "application/json"})
    try:
        return urllib.request.urlopen(req, timeout=timeout)
    except urllib.error.HTTPError as e:
        detail = e.read().decode(errors="replace")
        try:
            detail = json.loads(detail)["error"]["message"]
        except Exception:
            pass
        raise UpstreamError(f"server returned {e.code}: {detail}", e.code)
    except urllib.error.URLError as e:
        raise UpstreamError(f"cannot reach {_server_url(m, '')} ({e.reason}). Is the model running?")


def pipe_response(handler, upstream):
    """Stream an upstream HTTP response to a BaseHTTPRequestHandler client."""
    with upstream:
        handler.send_response(200)
        handler.send_header("Content-Type", upstream.headers.get("Content-Type", "application/json"))
        handler.send_header("Cache-Control", "no-store")
        handler.end_headers()
        try:
            while chunk := upstream.read1(65536):
                handler.wfile.write(chunk)
                handler.wfile.flush()
        except (BrokenPipeError, ConnectionResetError):
            pass  # client went away; closing upstream makes llama-server stop generating


def stream_chat(m, messages, params, on_content, on_reasoning):
    """Stream a chat completion. Returns (content, timings or None)."""
    body = {"model": m.get("alias") or "local", "messages": messages, "stream": True, **params}
    content, timings = [], None
    with _post_json(m, "/v1/chat/completions", body) as r:
        for raw in r:
            line = raw.decode(errors="replace").strip()
            if not line.startswith("data:"):
                continue
            data = line[5:].strip()
            if data == "[DONE]":
                break
            j = json.loads(data)
            timings = j.get("timings") or timings
            for ch in j.get("choices") or []:
                d = ch.get("delta") or {}
                if d.get("reasoning_content"):
                    on_reasoning(d["reasoning_content"])
                if d.get("content"):
                    content.append(d["content"])
                    on_content(d["content"])
    return "".join(content), timings


def embed(m, text):
    with _post_json(m, "/v1/embeddings", {"model": m.get("alias") or "local", "input": text}) as r:
        return json.loads(r.read())["data"][0]["embedding"]


def cosine(a, b):
    dot = sum(x * y for x, y in zip(a, b))
    na, nb = sum(x * x for x in a) ** 0.5, sum(y * y for y in b) ** 0.5
    return dot / (na * nb) if na and nb else 0.0


def fmt_timings(t, wall):
    if not t:
        return f"{wall:.1f}s"
    return (f"{t.get('predicted_n', '?')} tokens @ {t.get('predicted_per_second', 0):.1f} tok/s · "
            f"prompt {t.get('prompt_n', '?')} tokens @ {t.get('prompt_per_second', 0):.0f} tok/s · {wall:.1f}s")


