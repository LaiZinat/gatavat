class UIHandler(BaseHTTPRequestHandler):
    server_version = "llmctl"
    allow_any_host = False

    def log_message(self, *args):
        pass

    def _send(self, code, obj=None, body=None, ctype="application/json"):
        data = body if body is not None else json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(data)

    def _guard(self, mutating):
        # Block DNS rebinding (Host check) and cross-site form posts (custom header forces
        # a CORS preflight, which this server never approves).
        host = (self.headers.get("Host") or "").rsplit(":", 1)[0].strip("[]")
        if not self.allow_any_host and host not in ("127.0.0.1", "localhost", "::1"):
            self._send(403, {"error": "forbidden host"})
            return False
        if mutating and self.headers.get("X-Requested-With") != "llmctl":
            self._send(403, {"error": "missing X-Requested-With header"})
            return False
        return True

    def _body(self):
        n = int(self.headers.get("Content-Length") or 0)
        return json.loads(self.rfile.read(n) or b"{}") if n else {}

    def _handle(self, method):
        if not self._guard(method != "GET"):
            return
        url = urlparse(self.path)
        parts = [p for p in url.path.split("/") if p]
        # /api/models/<id>/proxy/v1/... -> the model's server. Streams, so it must not hold the config lock.
        if method == "POST" and len(parts) >= 6 and parts[:2] == ["api", "models"] and parts[3:5] == ["proxy", "v1"]:
            return self._proxy(parts[2], "/" + "/".join(parts[4:]))
        try:
            with _config_lock:
                result = self._route(method, parts, parse_qs(url.query))
            if result is not None:
                self._send(200, result)
        except UserError as e:
            self._send(400, {"error": str(e)})
        except Exception as e:  # keep the UI alive and show the error
            self._send(500, {"error": f"{type(e).__name__}: {e}"})

    def _route(self, method, parts, query):
        if method == "GET" and not parts:
            self._send(200, body=UI_HTML.read_bytes(), ctype="text/html; charset=utf-8")
            return None
        if parts[:1] != ["api"]:
            self._send(404, {"error": "not found"})
            return None
        cfg = load_config()
        p = parts[1:]
        if method == "GET" and p == ["state"]:
            return state_payload(cfg)
        if p == ["global"] and method == "POST":
            body = self._body()
            for k in DEFAULT_GLOBAL:
                if k in body:
                    set_global(cfg, k, body[k])
            save_config(cfg)
            return state_payload(cfg)
        if p in (["gateway", "start"], ["gateway", "stop"]) and method == "POST":
            gateway_stop()
            if p[1] == "start":
                gateway_start(cfg)
            return state_payload(cfg)
        if p == ["opencode"]:
            if method == "GET":
                path, existing, out = opencode_merged(cfg)
                return {"path": str(path), "exists": path.exists(), "current": existing, "proposed": out}
            if method == "POST":
                path, backup = opencode_write(cfg)
                return {"path": str(path), "backup": str(backup) if backup else None}
        if p == ["models"] and method == "POST":
            body = self._body()
            mid = (body.get("id") or "").strip()
            if mid in cfg["models"]:
                raise UserError(f"model {mid!r} already exists")
            src = body.get("from")
            m = copy.deepcopy(cfg["models"][src]) if src in cfg["models"] else _model(host="127.0.0.1", ngl=999,
                                                                                     ctx_size=8192, jinja=True)
            m.update(name=mid, alias=mid, autostart=False, opencode_provider=None, port=next_free_port(cfg))
            m["model"] = m.get("model") or "$HOME/Models/LLM/"
            if not ID_RE.match(mid):
                raise UserError(f"invalid model id {mid!r} (letters, digits, . _ -)")
            cfg["models"][mid] = m
            save_config(cfg)
            return state_payload(cfg)
        if p == ["start-autostart"] and method == "POST":
            errors = []
            for mid, m in cfg["models"].items():
                if m.get("autostart") and model_status(mid, m, cfg["global"])["state"] in ("stopped", "exited"):
                    try:
                        start_model(cfg, mid)
                    except UserError as e:
                        errors.append(str(e))
            if errors:
                raise UserError("\n".join(errors))
            return state_payload(cfg)
        if p == ["stop-all"] and method == "POST":
            for mid in cfg["models"]:
                stop_model(mid)
            return state_payload(cfg)
        if len(p) >= 2 and p[0] == "models":
            mid = p[1]
            action = p[2] if len(p) > 2 else None
            if action == "logs" and method == "GET":
                n = int(query.get("n", ["300"])[0])
                return {"log": tail(log_file(mid), n), "path": str(log_file(mid))}
            if method == "DELETE" and action is None:
                get_model(cfg, mid)
                stop_model(mid)
                del cfg["models"][mid]
                save_config(cfg)
                return state_payload(cfg)
            if method == "POST" and action is None:
                get_model(cfg, mid)
                m = validate_model(mid, normalize_model(self._body()))
                cfg["models"][mid] = m
                save_config(cfg)
                return state_payload(cfg)
            if method == "POST" and action == "reset":
                if mid not in DEFAULT_MODELS:
                    raise UserError(f"{mid} has no built-in defaults")
                cfg["models"][mid] = copy.deepcopy(DEFAULT_MODELS[mid])
                save_config(cfg)
                return state_payload(cfg)
            if method == "POST" and action in ("start", "stop", "restart"):
                get_model(cfg, mid)
                if action in ("stop", "restart"):
                    stop_model(mid)
                if action in ("start", "restart"):
                    start_model(cfg, mid)
                return state_payload(cfg)
        self._send(404, {"error": "not found"})
        return None

    def _proxy(self, mid, path):
        try:
            m = get_model(load_config(), mid)
            upstream = _post_json(m, path, self._body())
        except UserError as e:
            self._send(502, {"error": str(e)})
            return
        pipe_response(self, upstream)

    def do_GET(self):
        self._handle("GET")

    def do_POST(self):
        self._handle("POST")

    def do_DELETE(self):
        self._handle("DELETE")


def run_ui(cfg, host, port, open_browser):
    UIHandler.allow_any_host = host not in ("127.0.0.1", "localhost", "::1")
    try:
        srv = ThreadingHTTPServer((host, port), UIHandler)
    except OSError as e:
        raise UserError(f"cannot listen on {host}:{port}: {e}")
    url = f"http://{'127.0.0.1' if host in ('0.0.0.0', '::') else host}:{port}/"
    print(f"llmctl UI on {url}  (Ctrl-C to quit; running models keep running)")
    if open_browser:
        threading.Timer(0.5, lambda: webbrowser.open(url)).start()
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print()
    finally:
        srv.server_close()


