def opencode_merged(cfg):
    path = Path(expand(cfg["global"]["opencode_path"]))
    existing = {}
    if path.exists():
        try:
            existing = json.loads(path.read_text())
        except json.JSONDecodeError as e:
            raise UserError(f"{path} is not valid JSON: {e}")
    out = copy.deepcopy(existing)
    out.setdefault("$schema", "https://opencode.ai/config.json")
    providers = out.setdefault("provider", {})
    g = cfg["global"]
    exported = [(mid, m) for mid, m in cfg["models"].items() if m.get("opencode_provider") and not m.get("embedding")]
    if g.get("opencode_mode", "gateway") == "gateway":
        pid = g.get("opencode_provider_id") or "llama-local"
        renamed = {}
        for mid, m in exported:
            key, old_pid = m.get("alias") or mid, m["opencode_provider"]
            # Move the model out of its old per-model provider (drop that provider once empty).
            if old_pid != pid and isinstance(providers.get(old_pid), dict):
                providers[old_pid].get("models", {}).pop(key, None)
                if not providers[old_pid].get("models"):
                    del providers[old_pid]
                renamed[f"{old_pid}/{key}"] = f"{pid}/{key}"
        prov = providers.setdefault(pid, {})
        prov.setdefault("npm", "@ai-sdk/openai-compatible")
        prov.setdefault("name", "llama.cpp (local)")
        opts = prov.setdefault("options", {})
        opts["baseURL"] = gateway_url(g)
        opts.setdefault("timeout", 600000)
        pmodels = prov.setdefault("models", {})
        for mid, m in exported:
            entry = pmodels.setdefault(m.get("alias") or mid, {"name": m["name"]})
            entry["limit"] = {"context": m["ctx_size"], "output": m.get("opencode_output") or 8192}
        # Keep the default model and agents pointing at the moved models.
        for k in ("model", "small_model"):
            if out.get(k) in renamed:
                out[k] = renamed[out[k]]
        for agent in (out.get("agent") or {}).values():
            if isinstance(agent, dict) and agent.get("model") in renamed:
                agent["model"] = renamed[agent["model"]]
        return path, existing, out
    for mid, m in exported:
        pid = m["opencode_provider"]
        prov = providers.setdefault(pid, {})
        prov.setdefault("npm", "@ai-sdk/openai-compatible")
        prov.setdefault("name", f"llama.cpp — {m['name']}")
        opts = prov.setdefault("options", {})
        opts["baseURL"] = f"http://{client_host(m)}:{m['port']}/v1"
        opts.setdefault("timeout", 600000)
        entry = prov.setdefault("models", {}).setdefault(m.get("alias") or mid, {"name": m["name"]})
        entry["limit"] = {"context": m["ctx_size"], "output": m.get("opencode_output") or 8192}
    return path, existing, out


def opencode_stale(cfg):
    """True when opencode.json exists but no longer matches what --write would produce."""
    try:
        path, existing, out = opencode_merged(cfg)
    except UserError:
        return None
    return path.exists() and out != existing


OPENCODE_HINT = "opencode.json is out of date: run `llmctl opencode --write`, then restart opencode"


def opencode_write(cfg):
    path, existing, out = opencode_merged(cfg)
    backup = None
    if path.exists():
        backup = path.with_name(f"{path.name}.backup-{time.strftime('%Y%m%d-%H%M%S')}")
        shutil.copy2(path, backup)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(out, indent=2, ensure_ascii=False) + "\n")
    return path, backup


